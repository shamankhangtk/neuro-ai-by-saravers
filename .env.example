# Free-tier AI chat and Google Search grounding (recommended starting point)
# Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional image generation through Hugging Face Inference Providers.
# Free accounts have small monthly credits/limits; image generation is not unlimited-free.
# Create a token at https://huggingface.co/settings/tokens
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Optional paid OpenAI override. If set, OpenAI takes priority over Gemini.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional paid OpenAI image generation override (takes priority over Hugging Face).
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium

# Admin login (set unique, strong values before deploying)
NEURO_ADMIN_USERNAME=admin
NEURO_ADMIN_PASSWORD=replace-with-a-unique-random-password-at-least-16-characters

# Optional: configure a public API URL only if frontend and backend are hosted separately.
# Leave empty when the same Express server serves both the website and API.
EXPO_PUBLIC_API_BASE_URL=

# Optional legacy Manus-compatible AI provider fallback. Provider priority: OpenAI, Gemini, then Manus.
# MANUS_API_URL=https://your-provider.example
# MANUS_API_KEY=your_provider_key
